        "@dataclass\n",
        "class TrackResult:\n",
        "    \"\"\"Represents a single track result\"\"\"\n",
        "    camera_id: str\n",
        "    local_track_id: int\n",
        "    bbox: List[float]  # [x1, y1, x2, y2]\n",
        "    confidence: float\n",
        "    is_new: bool\n",
        "    reid_features: Optional[torch.Tensor] = None\n",
        "    global_target_id: Optional[int] = None\n"
      ]
