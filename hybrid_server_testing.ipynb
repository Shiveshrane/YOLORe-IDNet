  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d3610d0d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🚀 Standalone ReID and CLIP Implementation\n",
    "print(\"🔧 Initializing Standalone ReID and CLIP Components...\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Standalone AlignedReID Implementation\n",
    "class StandaloneAlignedReID:\n",
    "    \"\"\"Standalone implementation of AlignedReID functionality\"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "        print(f\"🔄 Initializing ReID model on {self.device}\")\n",
    "        \n",
    "        # Create the ReID model using the existing create_reid_model function\n",
    "        try:\n",
    "            self.model = create_reid_model(num_classes=751, aligned=True)\n",
    "            \n",
    "            # Try to load pretrained weights if available - FIXED for PyTorch 2.6\n",
    "            checkpoint_path = \"./log/checkpoint_ep300.pth.tar\"\n",
    "            if os.path.exists(checkpoint_path):\n",
    "                print(f\"📦 Loading pretrained weights from {checkpoint_path}\")\n",
    "                try:\n",
    "                    # First try with weights_only=True (secure)\n",
    "                    checkpoint = torch.load(checkpoint_path, map_location=self.device, weights_only=True)\n",
    "                    print(\"✅ Loaded checkpoint with secure weights_only=True\")\n",
    "                except Exception as secure_error:\n",
    "                    print(f\"⚠️ Secure loading failed: {str(secure_error)[:100]}...\")\n",
    "                    try:\n",
    "                        # Fallback to weights_only=False with explicit safety warning\n",
    "                        print(\"🔓 Attempting to load with weights_only=False (trusted source)\")\n",
    "                        checkpoint = torch.load(checkpoint_path, map_location=self.device, weights_only=False)\n",
    "                        print(\"✅ Loaded checkpoint with weights_only=False\")\n",
    "                    except Exception as fallback_error:\n",
    "                        print(f\"❌ Both loading methods failed: {fallback_error}\")\n",
    "                        checkpoint = None\n",
    "                \n",
    "                if checkpoint is not None:\n",
    "                    try:\n",
    "                        if 'state_dict' in checkpoint:\n",
    "                            self.model.load_state_dict(checkpoint['state_dict'], strict=False)\n",
    "                        else:\n",
    "                            self.model.load_state_dict(checkpoint, strict=False)\n",
    "                        print(\"✅ Pretrained weights loaded successfully\")\n",
    "                    except Exception as load_error:\n",
    "                        print(f\"⚠️ Weight loading failed, using ImageNet initialization: {load_error}\")\n",
    "                else:\n",
    "                    print(\"⚠️ Could not load checkpoint, using ImageNet initialization\")\n",
    "            else:\n",
    "                print(\"⚠️ No pretrained weights found, using ImageNet initialization\")\n",
    "            \n",
    "            self.model.to(self.device)\n",
    "            self.model.eval()\n",
    "            \n",
    "            # ReID image preprocessing\n",
    "            self.transform = transforms.Compose([\n",
    "                transforms.Resize((256, 128)),\n",
    "                transforms.ToTensor(),\n",
    "                transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                                   std=[0.229, 0.224, 0.225])\n",
    "            ])\n",
    "            \n",
    "            print(\"✅ Standalone ReID model initialized successfully\")\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error initializing ReID model: {e}\")\n",
    "            self.model = None\n",
    "            self.transform = None\n",
    "    \n",
    "    def get_features(self, pil_image):\n",
    "        \"\"\"Extract ReID features from PIL image\"\"\"\n",
    "        if self.model is None or self.transform is None:\n",
    "            return None\n",
    "        \n",
    "        try:\n",
    "            # Preprocess image\n",
    "            if isinstance(pil_image, Image.Image):\n",
    "                input_tensor = self.transform(pil_image).unsqueeze(0).to(self.device)\n",
    "            else:\n",
    "                # Convert numpy array to PIL if needed\n",
    "                if isinstance(pil_image, np.ndarray):\n",
    "                    pil_image = Image.fromarray(pil_image)\n",
    "                input_tensor = self.transform(pil_image).unsqueeze(0).to(self.device)\n",
    "            \n",
    "            # Extract features\n",
    "            with torch.no_grad():\n",
    "                features = self.model(input_tensor)\n",
    "                if isinstance(features, tuple):\n",
    "                    features = features[0]  # Take global features\n",
    "                \n",
    "                # Normalize features\n",
    "                features = torch.nn.functional.normalize(features, p=2, dim=1)\n",
    "                \n",
    "            return features.squeeze().cpu()\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"⚠️ Feature extraction failed: {e}\")\n",
    "            return None\n",
    "\n",
    "# Standalone CLIP Person Identifier Implementation\n",
    "class StandaloneCLIPIdentifier:\n",
    "    \"\"\"Standalone implementation of CLIP-based person identification\"\"\"\n",
    "    \n",
    "    def __init__(self, device: str = None):\n",
    "        self.device = device if device else (\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "        print(f\"🔄 Initializing CLIP identifier on {self.device}\")\n",
    "        \n",
    "        try:\n",
    "            # Try to use transformers-based CLIP\n",
    "            from transformers import CLIPProcessor, CLIPModel\n",
    "            model_name = \"openai/clip-vit-base-patch32\"\n",
    "            \n",
    "            self.model = CLIPModel.from_pretrained(model_name).to(self.device)\n",
    "            self.processor = CLIPProcessor.from_pretrained(model_name)\n",
    "            self.model.eval()\n",
    "            \n",
    "            self.use_transformers = True\n",
    "            print(\"✅ Using transformers-based CLIP model\")\n",
    "            \n",
    "        except ImportError:\n",
    "            try:\n",
    "                # Fallback to original CLIP\n",
    "                import clip\n",
    "                self.model, self.preprocess = clip.load(\"ViT-B/32\", device=self.device)\n",
    "                self.model.eval()\n",
    "                self.use_transformers = False\n",
    "                print(\"✅ Using original CLIP model\")\n",
    "                \n",
    "            except ImportError:\n",
    "                print(\"❌ Neither transformers nor clip library available\")\n",
    "                self.model = None\n",
    "                self.use_transformers = False\n",
    "        \n",
    "        # Cache for target descriptions\n",
    "        self.target_embeddings_cache = {}\n",
    "        \n",
    "        print(\"✅ Standalone CLIP identifier initialized successfully\")\n",
    "    \n",
    "    def add_target_description(self, target_id: int, description: str):\n",
    "        \"\"\"Add a target description to cache\"\"\"\n",
    "        if self.model is None:\n",
    "            return\n",
    "        \n",
    "        try:\n",
    "            if self.use_transformers:\n",
    "                # Use transformers\n",
    "                inputs = self.processor(text=[description], return_tensors=\"pt\", padding=True)\n",
    "                inputs = {k: v.to(self.device) for k, v in inputs.items()}\n",
    "                \n",
    "                with torch.no_grad():\n",
    "                    text_features = self.model.get_text_features(**inputs)\n",
    "                    text_features = text_features / text_features.norm(dim=-1, keepdim=True)\n",
    "            else:\n",
    "                # Use original CLIP\n",
    "                import clip\n",
    "                text_tokens = clip.tokenize([description]).to(self.device)\n",
    "                \n",
    "                with torch.no_grad():\n",
    "                    text_features = self.model.encode_text(text_tokens)\n",
    "                    text_features = text_features / text_features.norm(dim=-1, keepdim=True)\n",
    "            \n",
    "            self.target_embeddings_cache[target_id] = {\n",
    "                'description': description,\n",
    "                'embedding': text_features\n",
    "            }\n",
    "            \n",
    "            print(f\"✅ Added target {target_id}: '{description}'\")\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error adding target description: {e}\")\n",
    "    \n",
    "    def remove_target_description(self, target_id: int):\n",
    "        \"\"\"Remove a target description from cache\"\"\"\n",
    "        if target_id in self.target_embeddings_cache:\n",
    "            del self.target_embeddings_cache[target_id]\n",
    "            print(f\"🗑️ Removed target {target_id}\")\n",
    "    \n",
    "    def identify_new_person(self, frame: np.ndarray, person_bbox: List, \n",
    "                           confidence_threshold: float = 0.25):\n",
    "        \"\"\"Identify if a new person matches any target descriptions\"\"\"\n",
    "        if self.model is None or len(self.target_embeddings_cache) == 0:\n",
    "            return None\n",
    "        \n",
    "        try:\n",
    "            # Extract person crop - handle both int and float bbox formats\n",
    "            if isinstance(person_bbox, (list, tuple, np.ndarray)):\n",
    "                x1, y1, x2, y2 = map(int, person_bbox[:4])  # Convert to int\n",
    "            else:\n",
    "                return None\n",
    "                \n",
    "            h, w = frame.shape[:2]\n",
    "            \n",
    "            # Ensure coordinates are valid\n",
    "            x1 = max(0, min(x1, w-1))\n",
    "            y1 = max(0, min(y1, h-1))\n",
    "            x2 = max(x1+1, min(x2, w))\n",
    "            y2 = max(y1+1, min(y2, h))\n",
    "            \n",
    "            person_crop = frame[y1:y2, x1:x2]\n",
    "            \n",
    "            if person_crop.size == 0:\n",
    "                return None\n",
    "            \n",
    "            # Convert to PIL Image\n",
    "            person_crop_rgb = cv2.cvtColor(person_crop, cv2.COLOR_BGR2RGB)\n",
    "            pil_image = Image.fromarray(person_crop_rgb)\n",
    "            \n",
    "            # Extract image features\n",
    "            if self.use_transformers:\n",
    "                inputs = self.processor(images=pil_image, return_tensors=\"pt\", padding=True)\n",
    "                inputs = {k: v.to(self.device) for k, v in inputs.items()}\n",
    "                \n",
    "                with torch.no_grad():\n",
    "                    image_features = self.model.get_image_features(**inputs)\n",
    "                    image_features = image_features / image_features.norm(dim=-1, keepdim=True)\n",
    "            else:\n",
    "                image_tensor = self.preprocess(pil_image).unsqueeze(0).to(self.device)\n",
    "                \n",
    "                with torch.no_grad():\n",
    "                    image_features = self.model.encode_image(image_tensor)\n",
    "                    image_features = image_features / image_features.norm(dim=-1, keepdim=True)\n",
    "            \n",
    "            # Compare with all cached targets\n",
    "            best_match = None\n",
    "            best_score = 0.0\n",
    "            \n",
    "            for target_id, target_data in self.target_embeddings_cache.items():\n",
    "                text_features = target_data['embedding']\n",
    "                \n",
    "                # Compute similarity\n",
    "                similarity = torch.cosine_similarity(image_features, text_features, dim=1).item()\n",
    "                \n",
    "                if similarity > best_score and similarity >= confidence_threshold:\n",
    "                    best_score = similarity\n",
    "                    best_match = (target_id, similarity, target_data['description'])\n",
    "            \n",
    "            return best_match\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error in person identification: {e}\")\n",
    "            return None\n",
    "\n",
    "# Initialize the standalone components\n",
    "print(\"🚀 Creating standalone instances...\")\n",
    "\n",
    "try:\n",
    "    ReId = StandaloneAlignedReID()\n",
    "    clip_identifier = StandaloneCLIPIdentifier()\n",
    "    \n",
    "    print(\"✅ All components initialized successfully!\")\n",
    "    print(\"✅ ReID and CLIP modules ready for standalone operation\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Initialization error: {e}\")\n",
    "    import traceback\n",
    "    traceback.print_exc()\n",
    "    \n",
    "    # Create minimal dummy objects as fallback\n",
    "    class MinimalReID:\n",
    "        def get_features(self, image):\n",
    "            print(\"⚠️ Using minimal ReID - returning random features\")\n",
    "            return torch.randn(2048) if torch.is_available else None\n",
    "    \n",
    "    class MinimalCLIP:\n",
    "        def add_target_description(self, target_id, description):\n",
    "            print(f\"⚠️ Minimal CLIP: Added target {target_id}\")\n",
    "        def identify_new_person(self, frame, bbox, threshold=0.25):\n",
    "            print(\"⚠️ Using minimal CLIP - returning None\")\n",
    "            return None\n",
    "        def remove_target_description(self, target_id):\n",
    "            print(f\"⚠️ Minimal CLIP: Removed target {target_id}\")\n",
    "    \n",
    "    ReId = MinimalReID()\n",
    "    clip_identifier = MinimalCLIP()\n",
    "    print(\"⚠️ Using minimal fallback objects\")"
   ]
  },
