        "    def __init__(self, device: str = None, model_name: str = \"openai/clip-vit-base-patch32\"):\n",
        "        self.device = device if device else (\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "        \n",
        "        print(f\"🔍 DEBUG: Initializing CLIP on device: {self.device}\")\n",
        "        print(f\"🔍 DEBUG: CLIP model: {model_name}\")\n",
        "\n",
        "        try:\n",
        "            # Load CLIP model and processor\n",
        "            self.model = CLIPModel.from_pretrained(model_name).to(self.device)\n",
        "            self.processor = CLIPProcessor.from_pretrained(model_name)\n",
        "            self.model.eval()\n",
        "\n",
        "            print(f\"✅ DEBUG: CLIP model {model_name} loaded successfully on {self.device}\")\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"❌ DEBUG: CLIP loading failed: {e}\")\n",
        "            import traceback\n",
        "            traceback.print_exc()\n",
        "            self.model = None\n",
        "            self.processor = None\n",
        "\n",
        "        # Cache for target descriptions\n",
        "        self.target_embeddings_cache = {}\n",
        "        print(f\"🔍 DEBUG: CLIP identifier initialized - model available: {self.model is not None}\")"
      ]
