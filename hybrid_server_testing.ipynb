    "class EnhancedDeepSortTracker:\n",
    "    \"\"\"\n",
    "    Enhanced Deep SORT-style tracker with ReID-integrated association\n",
    "    \"\"\"\n",
    "    def __init__(self, camera_id: str):\n",
    "        self.camera_id = camera_id\n",
    "        self.trackers = []\n",
    "        self.frame_count = 0\n",
    "        self.max_age = 20  # Reduced from 30 to prevent stale tracks\n",
    "        self.min_hits = 2  # Reduced from 3 for faster track confirmation\n",
    "        self.iou_threshold = 0.25  # Lowered for better matching in crowds\n",
    "        self.reid_threshold = 0.5  # Lowered for more forgiving ReID matching\n",
    "\n",
    "        # Crowd density estimation\n",
    "        self.recent_detection_counts = deque(maxlen=30)  # Last 30 frames\n",
    "        self.crowd_density = 'medium'\n",
    "\n",
    "    def estimate_crowd_density(self, num_detections):\n",
    "        \"\"\"Estimate crowd density based on recent detection patterns\"\"\"\n",
    "        self.recent_detection_counts.append(num_detections)\n",
    "\n",
    "        if len(self.recent_detection_counts) < 10:\n",
    "            return self.crowd_density\n",
    "\n",
    "        avg_detections = np.mean(self.recent_detection_counts)\n",
    "\n",
    "        # Dynamic thresholds based on camera setup\n",
    "        if avg_detections <= 3:\n",
    "            self.crowd_density = 'low'\n",
    "        elif avg_detections <= 8:\n",
    "            self.crowd_density = 'medium'\n",
    "        else:\n",
    "            self.crowd_density = 'high'\n",
    "\n",
    "        return self.crowd_density\n",
    "\n",
    "    def compute_reid_quality(self, reid_feature, bbox_area):\n",
    "        \"\"\"Estimate quality of extracted ReID feature\"\"\"\n",
    "        if reid_feature is None:\n",
    "            return 0.0\n",
    "\n",
    "        # Feature norm as quality indicator\n",
    "        feature_norm = torch.norm(reid_feature).item()\n",
    "\n",
    "        # Bbox area as quality factor (larger area = better feature)\n",
    "        area_factor = min(1.0, bbox_area / 10000.0)  # Normalize\n",
    "\n",
    "        # Combine factors\n",
    "        quality = min(1.0, feature_norm * area_factor)\n",
    "\n",
    "        return quality\n",
    "\n",
    "    def update(self, detections: np.ndarray, reid_features: List[torch.Tensor], \n",
    "               matched_detections: List[int] = None) -> List[TrackResult]:\n",
    "        \"\"\"Enhanced update with ReID-integrated association - only track matched detections\"\"\"\n",
    "        self.frame_count += 1\n",
    "\n",
    "        # If matched_detections is provided, only process those detections\n",
    "        if matched_detections is not None:\n",
    "            # Filter detections to only include matched ones\n",
    "            if len(matched_detections) > 0:\n",
    "                detections = detections[matched_detections]\n",
    "                reid_features = [reid_features[i] if i < len(reid_features) else None \n",
    "                               for i in matched_detections]\n",
    "                print(f\"🔍 DEBUG: Processing {len(detections)} matched detections out of original set\")\n",
    "            else:\n",
    "                # No matched detections, only predict existing trackers\n",
    "                detections = np.array([]).reshape(0, 6)\n",
    "                reid_features = []\n",
    "                print(f\"🔍 DEBUG: No matched detections, only predicting existing trackers\")\n",
    "\n",
    "        # Estimate crowd density\n",
    "        crowd_density = self.estimate_crowd_density(len(detections))\n",
    "\n",
    "        # Predict existing trackers\n",
    "        print(f\"🔍 DEBUG: Predicting {len(self.trackers)} existing trackers\")\n",
    "        for tracker in self.trackers:\n",
    "            tracker.predict()\n",
    "\n",
    "        # Enhanced association with ReID integration\n",
    "        matched, unmatched_dets, unmatched_trks = associate_detections_to_trackers(\n",
    "            detections, self.trackers, reid_features,\n",
    "            self.iou_threshold, self.reid_threshold, crowd_density\n",
    "        )\n",
    "\n",
    "        print(f\"🔍 DEBUG: Association results - Matched: {len(matched)}, Unmatched dets: {len(unmatched_dets)}, Unmatched tracks: {len(unmatched_trks)}\")\n",
    "\n",
    "        # Update matched trackers with enhanced feature management\n",
    "        for match in matched:\n",
    "            det_idx, trk_idx = match[0], match[1]\n",
    "            detection = detections[det_idx]\n",
    "            reid_feature = reid_features[det_idx] if det_idx < len(reid_features) else None\n",
    "            confidence = detection[4] if len(detection) > 4 else 1.0\n",
    "\n",
    "            # Compute ReID quality\n",
    "            bbox_area = (detection[2] - detection[0]) * (detection[3] - detection[1])\n",
    "            reid_quality = self.compute_reid_quality(reid_feature, bbox_area)\n",
    "\n",
    "            print(f\"🔄 DEBUG: Updating tracker {trk_idx} with detection {det_idx} (conf: {confidence:.3f}, reid_qual: {reid_quality:.3f})\")\n",
    "\n",
    "            self.trackers[trk_idx].update(\n",
    "                detection[:4],\n",
    "                reid_feature=reid_feature,\n",
    "                confidence=confidence,\n",
    "                reid_quality=reid_quality\n",
    "            )\n",
    "\n",
    "        # Mark unmatched trackers as missed\n",
    "        for trk_idx in unmatched_trks:\n",
    "            self.trackers[trk_idx].mark_missed()\n",
    "            print(f\"❌ DEBUG: Tracker {trk_idx} marked as missed\")\n",
    "\n",
    "        # Create new trackers for unmatched detections (only if they match targets)\n",
    "        for det_idx in unmatched_dets:\n",
    "            detection = detections[det_idx]\n",
    "            reid_feature = reid_features[det_idx] if det_idx < len(reid_features) else None\n",
    "\n",
    "            new_tracker = KalmanTracker(detection[:4], self.frame_count)\n",
    "            if reid_feature is not None:\n",
    "                bbox_area = (detection[2] - detection[0]) * (detection[3] - detection[1])\n",
    "                reid_quality = self.compute_reid_quality(reid_feature, bbox_area)\n",
    "                new_tracker.reid_features.append(reid_feature)\n",
    "                new_tracker.reid_quality_scores.append(reid_quality)\n",
    "                new_tracker.avg_reid_quality = reid_quality\n",
    "\n",
    "            self.trackers.append(new_tracker)\n",
    "            print(f\"➕ DEBUG: Created new tracker {new_tracker.id} for unmatched detection {det_idx}\")\n",
    "\n",
    "        # Remove dead trackers\n",
    "        initial_count = len(self.trackers)\n",
    "        self.trackers = [t for t in self.trackers if not t.should_delete()]\n",
    "        removed_count = initial_count - len(self.trackers)\n",
    "        if removed_count > 0:\n",
    "            print(f\"🗑️ DEBUG: Removed {removed_count} dead trackers\")\n",
    "\n",
    "        # Convert to TrackResult format with ReID confidence\n",
    "        results = []\n",
    "        for tracker in self.trackers:\n",
    "            if tracker.hits >= self.min_hits or tracker.time_since_update <= 1:\n",
    "                bbox = tracker.get_state()[0]\n",
    "\n",
    "                result = TrackResult(\n",
    "                    camera_id=self.camera_id,\n",
    "                    local_track_id=tracker.id,\n",
    "                    bbox=bbox.tolist(),\n",
    "                    confidence=tracker.avg_confidence,\n",
    "                    is_new=tracker.hits == 1,\n",
    "                    reid_features=tracker.reid_features[-1] if tracker.reid_features else None\n",
    "                )\n",
    "                results.append(result)\n",
    "\n",
    "        print(f\"🔍 DEBUG: Returning {len(results)} track results from {len(self.trackers)} total trackers\")\n",
    "        return results\n",
    "\n",
    "class PerCameraTracker:\n",
    "    \"\"\"Per-camera tracker using Deep SORT or ByteTrack - only tracks target matches\"\"\"\n",
    "\n",
    "    def __init__(self, camera_id: str, tracker_type: str = 'deepsort'):\n",
    "        self.camera_id = camera_id\n",
    "        self.tracker_type = tracker_type\n",
    "        self.local_tracks = {}  # Maps local track IDs to global target IDs\n",
    "        self.target_track_history = {}  # Track target ID assignment history\n",
    "        self.lost_tracks = {}  # Store recently lost tracks for recovery\n",
    "\n",
    "        if tracker_type == 'deepsort':\n",
    "            self.tracker = EnhancedDeepSortTracker(camera_id)\n",
    "        else:\n",
    "            # In production, add ByteTrack implementation\n",
    "            self.tracker = EnhancedDeepSortTracker(camera_id)  # Fallback for now\n",
    "\n",
    "        logger.info(f\"Initialized {tracker_type} tracker for camera {camera_id}\")\n",
    "\n",
    "    def cleanup_lost_tracks(self, current_frame_tracks):\n",
    "        \"\"\"Clean up lost tracks that haven't been seen for too long\"\"\"\n",
    "        current_track_ids = set(track.local_track_id for track in current_frame_tracks)\n",
    "        \n",
    "        # Move lost tracks to recovery storage\n",
    "        lost_track_ids = set(self.local_tracks.keys()) - current_track_ids\n",
    "        for track_id in lost_track_ids:\n",
    "            if track_id in self.local_tracks:\n",
    "                target_id = self.local_tracks[track_id]\n",
    "                self.lost_tracks[track_id] = {\n",
    "                    'target_id': target_id,\n",
    "                    'lost_frame': self.tracker.frame_count\n",
    "                }\n",
    "                print(f\"🔄 DEBUG: Moving track {track_id} (target {target_id}) to lost tracks\")\n",
    "        \n",
    "        # Remove tracks that have been lost too long (>30 frames)\n",
    "        recovery_limit = 90\n",
    "        to_remove = []\n",
    "        for track_id, lost_info in self.lost_tracks.items():\n",
    "            if self.tracker.frame_count - lost_info['lost_frame'] > recovery_limit:\n",
    "                to_remove.append(track_id)\n",
    "        \n",
    "        for track_id in to_remove:\n",
    "            del self.lost_tracks[track_id]\n",
    "            if track_id in self.local_tracks:\n",
    "                del self.local_tracks[track_id]\n",
    "            print(f\"🗑️ DEBUG: Permanently removed lost track {track_id}\")\n",
    "\n",
    "    def try_recover_track(self, new_track_id, target_id):\n",
    "        \"\"\"Try to recover a previously lost track with the same target ID\"\"\"\n",
    "        # Look for recently lost tracks with the same target ID\n",
    "        for lost_track_id, lost_info in self.lost_tracks.items():\n",
    "            if lost_info['target_id'] == target_id:\n",
    "                # Recovery successful - transfer the old track ID\n",
    "                self.local_tracks[new_track_id] = target_id\n",
    "                del self.lost_tracks[lost_track_id]\n",
    "                print(f\"🔄 DEBUG: Recovered track {lost_track_id} as new track {new_track_id} for target {target_id}\")\n",
    "                return True\n",
    "        return False\n",
    "\n",
    "    def process_frame(self, frame: np.ndarray, detections: np.ndarray, \n",
    "                     clip_identifier=None) -> List[TrackResult]:\n",
    "        \"\"\"Process frame and return tracking results - only track matched detections\"\"\"\n",
    "        try:\n",
    "            # First, identify which detections match our target descriptions\n",
    "            matched_detections = []\n",
    "            detection_target_mapping = {}  # Maps detection index to target ID\n",
    "            frame_height, frame_width = frame.shape[:2]\n",
    "\n",
    "            print(f\"🔍 DEBUG: Processing {len(detections)} detections for camera {self.camera_id}\")\n",
    "\n",
    "            for det_idx, det in enumerate(detections):\n",
    "                x1, y1, x2, y2 = map(int, det[:4])\n",
    "\n",
    "                # Ensure coordinates are within frame bounds\n",
    "                x1 = max(0, min(x1, frame_width - 1))\n",
    "                y1 = max(0, min(y1, frame_height - 1))\n",
    "                x2 = max(x1 + 1, min(x2, frame_width))\n",
    "                y2 = max(y1 + 1, min(y2, frame_height))\n",
    "\n",
    "                # Check if this detection matches any target description\n",
    "                if clip_identifier:\n",
    "                    clip_match = clip_identifier.identify_new_person(\n",
    "                        frame, [x1, y1, x2, y2], confidence_threshold=0.20  # Lowered threshold\n",
    "                    )\n",
    "                    \n",
    "                    if clip_match:\n",
    "                        target_id, similarity_score, description = clip_match\n",
    "                        matched_detections.append(det_idx)\n",
    "                        detection_target_mapping[det_idx] = target_id\n",
    "                        print(f\"✅ DEBUG: Detection {det_idx} matches target {target_id} (score: {similarity_score:.3f}) - '{description[:30]}...'\")\n",
    "                    else:\n",
    "                        # Try with lower threshold to see all scores\n",
    "                        low_threshold_match = clip_identifier.identify_new_person(\n",
    "                            frame, [x1, y1, x2, y2], confidence_threshold=0.1\n",
    "                        )\n",
    "                        if low_threshold_match:\n",
    "                            target_id, similarity_score, description = low_threshold_match\n",
    "                            print(f\"🔶 DEBUG: Detection {det_idx} matches target {target_id} with low score ({similarity_score:.3f}) - below threshold\")\n",
    "                        else:\n",
    "                            print(f\"❌ DEBUG: Detection {det_idx} does not match any target (no score above 0.1)\")\n",
    "                else:\n",
    "                    print(f\"⚠️ DEBUG: No CLIP identifier provided\")\n",
    "\n",
    "            print(f\"🔍 DEBUG: {len(matched_detections)} out of {len(detections)} detections matched targets\")\n",
    "            print(f\"🔍 DEBUG: Detection to target mapping: {detection_target_mapping}\")\n",
    "            \n",
    "            # Extract ReID features only for matched detections\n",
    "            reid_features = []\n",
    "            if matched_detections:\n",
    "                for det_idx in matched_detections:\n",
    "                    det = detections[det_idx]\n",
    "                    x1, y1, x2, y2 = map(int, det[:4])\n",
    "\n",
    "                    # Ensure coordinates are within frame bounds\n",
    "                    x1 = max(0, min(x1, frame_width - 1))\n",
    "                    y1 = max(0, min(y1, frame_height - 1))\n",
    "                    x2 = max(x1 + 1, min(x2, frame_width))\n",
    "                    y2 = max(y1 + 1, min(y2, frame_height))\n",
    "\n",
    "                    person_crop = frame[y1:y2, x1:x2]\n",
    "\n",
    "                    if person_crop.size > 0:\n",
    "                        try:\n",
    "                            person_crop_rgb = cv2.cvtColor(person_crop, cv2.COLOR_BGR2RGB)\n",
    "                            pil_image = Image.fromarray(person_crop_rgb)\n",
    "                            features = ReId.get_features(pil_image)\n",
    "                            reid_features.append(features)\n",
    "                        except Exception as crop_error:\n",
    "                            logger.warning(f\"Failed to extract ReID features: {crop_error}\")\n",
    "                            reid_features.append(None)\n",
    "                    else:\n",
    "                        reid_features.append(None)\n",
    "\n",
    "            # Update tracker with only matched detections\n",
    "            tracks = self.tracker.update(detections, reid_features, matched_detections)\n",
    "\n",
    "            # FIXED: Associate tracks with their target IDs using proper matching\n",
    "            for track in tracks:\n",
    "                local_track_id = track.local_track_id\n",
    "                \n",
    "                # For new tracks, find the correct target ID based on spatial proximity\n",
    "                if track.is_new:\n",
    "                    assigned_target_id = None\n",
    "                    best_overlap = 0.0\n",
    "                    best_detection_idx = None\n",
    "                    \n",
    "                    # Find which detection this track came from by checking bbox overlap\n",
    "                    track_bbox = track.bbox\n",
    "                    \n",
    "                    for matched_det_idx in matched_detections:\n",
    "                        det_bbox = detections[matched_det_idx][:4]\n",
    "                        overlap = compute_iou(track_bbox, det_bbox)\n",
    "                        \n",
    "                        if overlap > best_overlap and overlap > 0.3:  # Lower threshold for better matching\n",
    "                            best_overlap = overlap\n",
    "                            assigned_target_id = detection_target_mapping[matched_det_idx]\n",
    "                            best_detection_idx = matched_det_idx\n",
    "                    \n",
    "                    if assigned_target_id is not None:\n",
    "                        # Try to recover a lost track first\n",
    "                        if self.try_recover_track(local_track_id, assigned_target_id):\n",
    "                            track.global_target_id = assigned_target_id\n",
    "                        else:\n",
    "                            # New assignment\n",
    "                            self.local_tracks[local_track_id] = assigned_target_id\n",
    "                            track.global_target_id = assigned_target_id\n",
    "                            print(f\"✅ DEBUG: New track {local_track_id} assigned to target {assigned_target_id} (overlap: {best_overlap:.3f})\")\n",
    "                    else:\n",
    "                        print(f\"⚠️ DEBUG: Could not assign target ID to new track {local_track_id}\")\n",
    "                \n",
    "                # For existing tracks, maintain their target association\n",
    "                elif local_track_id in self.local_tracks:\n",
    "                    target_id = self.local_tracks[local_track_id]\n",
    "                    track.global_target_id = target_id\n",
    "                    # print(f\"🔄 DEBUG: Existing track {local_track_id} maintains target {target_id}\")\n",
    "\n",
    "            # Clean up lost tracks\n",
    "            self.cleanup_lost_tracks(tracks)\n",
    "\n",
    "            print(f\"🔍 DEBUG: Returning {len(tracks)} tracks\")\n",
    "            print(f\"🔍 DEBUG: Current local_tracks mapping: {dict(self.local_tracks)}\")\n",
    "            return tracks\n",
    "            \n",
    "        except Exception as e:\n",
    "            logger.error(f\"Error processing frame for camera {self.camera_id}: {e}\")\n",
    "            import traceback\n",
    "            traceback.print_exc()\n",
    "            return []\n",
    "\n",
    "class GlobalMultiCameraManager:\n",
    "    \"\"\"Global manager for multi-camera tracking with CLIP and ReID - Target-only tracking\"\"\"\n",
    "\n",
    "    def __init__(self):\n",
    "        self.camera_trackers: Dict[str, PerCameraTracker] = {}\n",
    "        self.global_targets: Dict[int, Dict] = {}\n",
    "        self.next_target_id = 1\n",
    "        self.reid_threshold = 0.6\n",
    "        self.clip_threshold = 0.25\n",
    "\n",
    "        logger.info(\"Initialized Global Multi-Camera Manager - Target-only tracking mode\")\n",
    "\n",
    "    def add_camera(self, camera_id: str, tracker_type: str = 'deepsort'):\n",
    "        \"\"\"Add a new camera with specified tracker type\"\"\"\n",
    "        self.camera_trackers[camera_id] = PerCameraTracker(camera_id, tracker_type)\n",
    "        logger.info(f\"Added camera {camera_id} with {tracker_type} tracker\")\n",
    "\n",
    "    def add_clip_target(self, description: str, target_name: str = None) -> int:\n",
    "        \"\"\"Add a new CLIP target description with validation\"\"\"\n",
    "        target_id = self.next_target_id\n",
    "        self.next_target_id += 1\n",
    "\n",
    "        if not target_name:\n",
    "            target_name = f\"Target_{target_id}\"\n",
    "\n",
    "        print(f\"🔍 DEBUG: Adding CLIP target {target_id}: '{description}' (name: {target_name})\")\n",
    "\n",
    "        self.global_targets[target_id] = {\n",
    "            'name': target_name,\n",
    "            'clip_description': description,\n",
    "            'reid_features': None,\n",
    "            'active_cameras': {},  # camera_id: local_track_id\n",
    "            'last_seen': None,\n",
    "            'first_detected': time.time(),\n",
    "            'confidence': 0.0,\n",
    "            'total_detections': 0,  # Track how many times this target was detected\n",
    "            'unique_track_ids': set()  # Track unique track IDs for this target\n",
    "        }\n",
    "\n",
    "        # Add to CLIP identifier with error handling\n",
    "        try:\n",
    "            clip_identifier.add_target_description(target_id, description)\n",
    "            print(f\"✅ DEBUG: Successfully added target to CLIP identifier\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ DEBUG: Error adding target to CLIP identifier: {e}\")\n",
    "            # Remove from global targets if CLIP addition failed\n",
    "            del self.global_targets[target_id]\n",
    "            return None\n",
    "\n",
    "        logger.info(f\"Added CLIP target {target_id}: '{description}'\")\n",
    "        print(f\"🔍 DEBUG: Total global targets: {len(self.global_targets)}\")\n",
    "        return target_id\n",
    "\n",
    "    def process_all_cameras(self, camera_frames: Dict[str, np.ndarray]) -> Dict[str, Any]:\n",
    "        \"\"\"Process all cameras and return comprehensive results - Target-only mode\"\"\"\n",
    "        all_camera_results = {}\n",
    "\n",
    "        # Step 1: Process each camera independently with target-only tracking\n",
    "        for camera_id, frame in camera_frames.items():\n",
    "            if camera_id not in self.camera_trackers:\n",
    "                logger.warning(f\"No tracker found for camera {camera_id}\")\n",
    "                continue\n",
    "\n",
    "            try:\n",
    "                print(f\"🔍 DEBUG: Processing camera {camera_id}, frame shape: {frame.shape}\")\n",
    "                \n",
    "                # Run YOLO detection with error handling\n",
    "                results = model(frame, verbose=False)  # Disable verbose output\n",
    "                print(f\"🔍 DEBUG: YOLO results type: {type(results)}, length: {len(results) if results else 'None'}\")\n",
    "\n",
    "                # Check if results are valid and extract detections\n",
    "                if results is None or len(results) == 0:\n",
    "                    print(f\"🔍 DEBUG: No YOLO results for {camera_id}\")\n",
    "                    all_camera_results[camera_id] = []\n",
    "                    continue\n",
    "\n",
    "                # Extract detections from YOLO results (updated for newer YOLO versions)\n",
    "                try:\n",
    "                    print(f\"🔍 DEBUG: Extracting detections from YOLO results...\")\n",
    "                    \n",
    "                    # For newer ultralytics YOLO versions\n",
    "                    if hasattr(results[0], 'boxes') and results[0].boxes is not None:\n",
    "                        boxes = results[0].boxes\n",
    "                        print(f\"🔍 DEBUG: Found {len(boxes)} boxes\")\n",
    "                        \n",
    "                        if len(boxes) == 0:\n",
    "                            all_camera_results[camera_id] = []\n",
    "                            continue\n",
    "\n",
    "                        # Convert to numpy format: [x1, y1, x2, y2, conf, class]\n",
    "                        detections = []\n",
    "                        for i in range(len(boxes)):\n",
    "                            try:\n",
    "                                box = boxes.xyxy[i].cpu().numpy()  # [x1, y1, x2, y2]\n",
    "                                conf = boxes.conf[i].cpu().numpy()\n",
    "                                cls = boxes.cls[i].cpu().numpy()\n",
    "                                detections.append([box[0], box[1], box[2], box[3], conf, cls])\n",
    "                            except Exception as box_error:\n",
    "                                print(f\"❌ DEBUG: Error processing box {i}: {box_error}\")\n",
    "                                continue\n",
    "                                \n",
    "                        detections = np.array(detections)\n",
    "                        print(f\"🔍 DEBUG: Converted {len(detections)} detections to numpy array\")\n",
    "\n",
    "                    # Fallback for older YOLO versions with pandas\n",
    "                    elif hasattr(results, 'pandas') and hasattr(results.pandas(), 'xyxy'):\n",
    "                        print(f\"🔍 DEBUG: Using pandas extraction method\")\n",
    "                        detections = results.pandas().xyxy[0].values\n",
    "                    else:\n",
    "                        # Alternative extraction method\n",
    "                        print(f\"🔍 DEBUG: Using alternative extraction method\")\n",
    "                        detections = []\n",
    "                        for result in results:\n",
    "                            if hasattr(result, 'boxes') and result.boxes is not None:\n",
    "                                boxes = result.boxes\n",
    "                                for i in range(len(boxes)):\n",
    "                                    box = boxes.xyxy[i].cpu().numpy()\n",
    "                                    conf = boxes.conf[i].cpu().numpy()\n",
    "                                    cls = boxes.cls[i].cpu().numpy()\n",
    "                                    detections.append([box[0], box[1], box[2], box[3], conf, cls])\n",
    "                        detections = np.array(detections) if detections else np.array([]).reshape(0, 6)\n",
    "\n",
    "                except Exception as detection_error:\n",
    "                    print(f\"❌ DEBUG: Detection extraction error: {detection_error}\")\n",
    "                    import traceback\n",
    "                    traceback.print_exc()\n",
    "                    logger.error(f\"Error extracting detections: {detection_error}\")\n",
    "                    all_camera_results[camera_id] = []\n",
    "                    continue\n",
    "\n",
    "                print(f\"🔍 DEBUG: Final detections shape: {detections.shape}\")\n",
    "\n",
    "                # Validate detections format\n",
    "                if len(detections) == 0 or (len(detections.shape) > 1 and detections.shape[1] < 6):\n",
    "                    print(f\"🔍 DEBUG: Invalid detections format - shape: {detections.shape}\")\n",
    "                    all_camera_results[camera_id] = []\n",
    "                    continue\n",
    "\n",
    "                # Filter for person detections\n",
    "                print(f\"🔍 DEBUG: Filtering for person detections (class 0)...\")\n",
    "                try:\n",
    "                    person_detections = detections[detections[:, 5] == 0]  # class 0 = person\n",
    "                    print(f\"🔍 DEBUG: Found {len(person_detections)} person detections\")\n",
    "                except Exception as filter_error:\n",
    "                    print(f\"❌ DEBUG: Person filtering error: {filter_error}\")\n",
    "                    print(f\"🔍 DEBUG: Detections array info - shape: {detections.shape}, dtype: {detections.dtype}\")\n",
    "                    if len(detections) > 0:\n",
    "                        print(f\"🔍 DEBUG: Sample detection: {detections[0]}\")\n",
    "                    all_camera_results[camera_id] = []\n",
    "                    continue\n",
    "\n",
    "                if len(person_detections) > 0:\n",
    "                    print(f\"🔍 DEBUG: Processing {len(person_detections)} person detections with camera tracker\")\n",
    "                    # Process with camera tracker - pass CLIP identifier for target matching\n",
    "                    camera_results = self.camera_trackers[camera_id].process_frame(\n",
    "                        frame, person_detections, clip_identifier\n",
    "                    )\n",
    "                    all_camera_results[camera_id] = camera_results\n",
    "                    print(f\"🔍 DEBUG: Camera tracker returned {len(camera_results)} target tracks\")\n",
    "                    \n",
    "                    # Update global target statistics\n",
    "                    for track in camera_results:\n",
    "                        if track.global_target_id and track.global_target_id in self.global_targets:\n",
    "                            target = self.global_targets[track.global_target_id]\n",
    "                            target['total_detections'] += 1\n",
    "                            target['unique_track_ids'].add(track.local_track_id)\n",
    "                            target['last_seen'] = time.time()\n",
    "                            \n",
    "                else:\n",
    "                    print(f\"🔍 DEBUG: No person detections found\")\n",
    "                    all_camera_results[camera_id] = []\n",
    "\n",
    "            except Exception as e:\n",
    "                print(f\"❌ DEBUG: Major error processing camera {camera_id}: {e}\")\n",
    "                import traceback\n",
    "                traceback.print_exc()\n",
    "                logger.error(f\"Error processing camera {camera_id}: {e}\")\n",
    "                all_camera_results[camera_id] = []\n",
    "\n",
    "        # Step 2: Update global target status - SIMPLIFIED\n",
    "        self.update_global_targets(all_camera_results)\n",
    "\n",
    "        # Step 3: Build comprehensive response\n",
    "        return self.build_response(all_camera_results)\n",
    "\n",
    "    def update_global_targets(self, all_camera_results: Dict[str, List[TrackResult]]):\n",
    "        \"\"\"Update global target information based on current frame results - SIMPLIFIED\"\"\"\n",
    "        \n",
    "        # Reset active cameras for this frame\n",
    "        for target_id in self.global_targets:\n",
    "            self.global_targets[target_id]['active_cameras'] = {}\n",
    "\n",
    "        # Update based on current tracks - SIMPLIFIED VALIDATION\n",
    "        for camera_id, camera_results in all_camera_results.items():\n",
    "            for track in camera_results:\n",
    "                if track.global_target_id and track.global_target_id in self.global_targets:\n",
    "                    target = self.global_targets[track.global_target_id]\n",
    "                    target['active_cameras'][camera_id] = track.local_track_id\n",
    "                    target['confidence'] = max(target.get('confidence', 0), track.confidence)\n",
    "\n",
    "    def build_response(self, all_camera_results: Dict[str, List[TrackResult]]) -> Dict[str, Any]:\n",
    "        \"\"\"Build comprehensive response with enhanced tracking information - Target-only mode\"\"\"\n",
    "        response = {\n",
    "            'hybrid_multi_camera_tracking': True,\n",
    "            'target_only_mode': True,  # Indicate this is target-only tracking\n",
    "            'timestamp': time.time(),\n",
    "            'global_targets': [],\n",
    "            'per_camera_results': {},\n",
    "            'tracking_analytics': {\n",
    "                'total_targets': len(self.global_targets),\n",
    "                'active_cameras': len(all_camera_results),\n",
    "                'total_target_tracks': sum(len(results) for results in all_camera_results.values()),\n",
    "                'target_statistics': {}\n",
    "            }\n",
    "        }\n",
    "\n",
    "        # Add global target information with enhanced statistics\n",
    "        for target_id, target_data in self.global_targets.items():\n",
    "            active_cameras = list(target_data['active_cameras'].keys())\n",
    "            response['global_targets'].append({\n",
    "                'target_id': target_id,\n",
    "                'name': target_data['name'],\n",
    "                'description': target_data['clip_description'],\n",
    "                'active_cameras': active_cameras,\n",
    "                'confidence': target_data.get('confidence', 0),\n",
    "                'last_seen': target_data['last_seen'],\n",
    "                'total_detections': target_data.get('total_detections', 0),\n",
    "                'unique_tracks': len(target_data.get('unique_track_ids', set())),\n",
    "                'tracking_method': 'clip_identified_target_only'\n",
    "            })\n",
    "\n",
    "            # Add to target statistics\n",
    "            response['tracking_analytics']['target_statistics'][target_id] = {\n",
    "                'name': target_data['name'],\n",
    "                'description': target_data['clip_description'],\n",
    "                'total_detections': target_data.get('total_detections', 0),\n",
    "                'unique_tracks': len(target_data.get('unique_track_ids', set())),\n",
    "                'cameras_seen': len(set().union(*[list(target_data['active_cameras'].keys())]))\n",
    "            }\n",
    "\n",
    "        # Add per-camera results with target-only focus\n",
    "        for camera_id, camera_results in all_camera_results.items():\n",
    "            tracks = []\n",
    "            target_tracks_count = 0\n",
    "\n",
    "            for track in camera_results:\n",
    "                # Only include tracks that are associated with valid targets\n",
    "                if track.global_target_id and track.global_target_id in self.global_targets:\n",
    "                    target_data = self.global_targets[track.global_target_id]\n",
    "                    track_info = {\n",
    "                        'local_track_id': track.local_track_id,\n",
    "                        'bbox': track.bbox,\n",
    "                        'confidence': track.confidence,\n",
    "                        'is_new': track.is_new,\n",
    "                        'global_target_id': track.global_target_id,\n",
    "                        'target_name': target_data['name'],\n",
    "                        'target_description': target_data['clip_description'],\n",
    "                        'tracking_method': 'clip_identified_target'\n",
    "                    }\n",
    "                    tracks.append(track_info)\n",
    "                    target_tracks_count += 1\n",
    "\n",
    "            response['per_camera_results'][camera_id] = {\n",
    "                'tracks': tracks,\n",
    "                'target_tracks_only': target_tracks_count,\n",
    "                'note': 'Only tracking targets matching descriptions'\n",
    "            }\n",
    "\n",
    "        return response\n",
    "\n",
    "# Global hybrid tracker instance\n",
    "hybrid_tracker = GlobalMultiCameraManager()\n",
    "\n",
    "def decode_base64_image(encoded_string: str) -> Optional[np.ndarray]:\n",
    "    \"\"\"Decode base64 encoded image with validation\"\"\"\n",
    "    try:\n",
    "        if not encoded_string or not isinstance(encoded_string, str):\n",
    "            return None\n",
    "\n",
    "        img_data = base64.b64decode(encoded_string)\n",
    "        nparr = np.frombuffer(img_data, np.uint8)\n",
    "        img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)\n",
    "\n",
    "        # Validate decoded image\n",
    "        if img is None or img.size == 0:\n",
    "            logger.warning(\"Decoded image is empty or invalid\")\n",
    "            return None\n",
    "\n",
    "        return img\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error decoding image: {e}\")\n",
    "        return None"
   ]
