      "source": [
        "# 🎯 AlignedReID++ Pretrained Weights Configuration for Colab\n",
        "# Configure this cell to load your specific pretrained weights\n",
        "\n",
        "print(\"🔧 AlignedReID++ Weights Configuration\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "# Option 1: Download from URL (recommended for Colab)\n",
        "# If you have your checkpoint hosted online, specify the URL here:\n",
        "CHECKPOINT_URL = None  # e.g., \"https://drive.google.com/uc?id=YOUR_FILE_ID\"\n",
        "\n",
        "# Option 2: Upload file directly in Colab\n",
        "# Set this to True to upload your checkpoint file\n",
        "UPLOAD_CHECKPOINT = False\n",
        "\n",
        "# Option 3: Google Drive integration\n",
        "# If you have the checkpoint in Google Drive, specify the path\n",
        "GDRIVE_CHECKPOINT_PATH = None  # e.g., \"/content/drive/MyDrive/checkpoints/checkpoint_ep300.pth.tar\"\n",
        "\n",
        "# Option 4: Local path (for local runs)\n",
        "LOCAL_CHECKPOINT_PATH = True  # e.g., \"./log/checkpoint_ep300.pth.tar\"\n",
        "\n",
        "def setup_alignedreid_checkpoint():\n",
        "    \"\"\"Setup AlignedReID checkpoint for Colab environment\"\"\"\n",
        "    checkpoint_path = \"/content/checkpoint_ep300.pth.tar\"\n",
        "\n",
        "    # Try different checkpoint sources\n",
        "    if CHECKPOINT_URL:\n",
        "        print(f\"📥 Downloading checkpoint from URL...\")\n",
        "        checkpoint_path = download_from_url(CHECKPOINT_URL)\n",
        "\n",
        "    elif UPLOAD_CHECKPOINT:\n",
        "        print(f\"📁 Upload your AlignedReID checkpoint file:\")\n",
        "        if 'google.colab' in str(get_ipython()):\n",
        "            from google.colab import files\n",
        "            uploaded = files.upload()\n",
        "\n",
        "            for filename in uploaded.keys():\n",
        "                if filename.endswith('.pth.tar') or filename.endswith('.pth'):\n",
        "                    # Move to expected location\n",
        "                    os.makedirs(\"./log\", exist_ok=True)\n",
        "                    new_path = \"./log/checkpoint_ep300.pth.tar\"\n",
        "\n",
        "                    import shutil\n",
        "                    shutil.move(filename, new_path)\n",
        "                    checkpoint_path = new_path\n",
        "                    print(f\"✅ Checkpoint uploaded and moved to: {new_path}\")\n",
        "                    break\n",
        "        else:\n",
        "            print(\"⚠️ File upload only works in Colab\")\n",
        "\n",
        "    elif GDRIVE_CHECKPOINT_PATH:\n",
        "        print(f\"📂 Using Google Drive checkpoint...\")\n",
        "        if os.path.exists(GDRIVE_CHECKPOINT_PATH):\n",
        "            checkpoint_path = GDRIVE_CHECKPOINT_PATH\n",
        "            print(f\"✅ Found checkpoint in Google Drive: {checkpoint_path}\")\n",
        "        else:\n",
        "            print(f\"❌ Google Drive checkpoint not found: {GDRIVE_CHECKPOINT_PATH}\")\n",
        "\n",
        "    elif LOCAL_CHECKPOINT_PATH:\n",
        "        print(f\"💻 Using local checkpoint...\")\n",
        "        if os.path.exists(LOCAL_CHECKPOINT_PATH):\n",
        "            checkpoint_path = LOCAL_CHECKPOINT_PATH\n",
        "            print(f\"✅ Found local checkpoint: {checkpoint_path}\")\n",
        "        else:\n",
        "            print(f\"❌ Local checkpoint not found: {LOCAL_CHECKPOINT_PATH}\")\n",
        "\n",
        "    return checkpoint_path\n",
        "\n",
        "def download_from_url(url):\n",
        "    \"\"\"Download checkpoint from URL\"\"\"\n",
        "    try:\n",
        "        import urllib.request\n",
        "        import os\n",
        "\n",
        "        # Create log directory\n",
        "        os.makedirs(\"./log\", exist_ok=True)\n",
        "        checkpoint_path = \"./log/checkpoint_ep300.pth.tar\"\n",
        "\n",
        "        print(f\"📥 Downloading from: {url}\")\n",
        "        print(\"⏳ This may take a few minutes...\")\n",
        "\n",
        "        urllib.request.urlretrieve(url, checkpoint_path)\n",
        "\n",
        "        # Verify download\n",
        "        if os.path.exists(checkpoint_path):\n",
        "            file_size = os.path.getsize(checkpoint_path) / (1024 * 1024)  # MB\n",
        "            print(f\"✅ Download complete! File size: {file_size:.1f} MB\")\n",
        "            return checkpoint_path\n",
        "        else:\n",
        "            print(f\"❌ Download failed - file not found\")\n",
        "            return None\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Download error: {e}\")\n",
        "        return None\n",
        "\n",
        "def mount_google_drive():\n",
        "    \"\"\"Mount Google Drive for accessing checkpoints\"\"\"\n",
        "    try:\n",
        "        if 'google.colab' in str(get_ipython()):\n",
        "            from google.colab import drive\n",
        "            drive.mount('/content/drive')\n",
        "            print(\"✅ Google Drive mounted successfully\")\n",
        "            return True\n",
        "        else:\n",
        "            print(\"⚠️ Google Drive mount only works in Colab\")\n",
        "            return False\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Failed to mount Google Drive: {e}\")\n",
        "        return False\n",
        "\n",
        "# Interactive configuration\n",
        "print(\"\\n🎯 CONFIGURATION OPTIONS:\")\n",
        "print(\"1. Set CHECKPOINT_URL to download from a direct link\")\n",
        "print(\"2. Set UPLOAD_CHECKPOINT=True to upload file manually\")\n",
        "print(\"3. Set GDRIVE_CHECKPOINT_PATH after mounting Google Drive\")\n",
        "print(\"4. Set LOCAL_CHECKPOINT_PATH for local development\")\n",
        "\n",
        "print(f\"\\n📋 CURRENT SETTINGS:\")\n",
        "print(f\"  CHECKPOINT_URL: {CHECKPOINT_URL}\")\n",
        "print(f\"  UPLOAD_CHECKPOINT: {UPLOAD_CHECKPOINT}\")\n",
        "print(f\"  GDRIVE_CHECKPOINT_PATH: {GDRIVE_CHECKPOINT_PATH}\")\n",
        "print(f\"  LOCAL_CHECKPOINT_PATH: {LOCAL_CHECKPOINT_PATH}\")\n",
        "\n",
        "# Auto-setup if any option is configured\n",
        "configured_checkpoint_path = None\n",
        "if any([CHECKPOINT_URL, UPLOAD_CHECKPOINT, GDRIVE_CHECKPOINT_PATH, LOCAL_CHECKPOINT_PATH]):\n",
        "    if GDRIVE_CHECKPOINT_PATH:\n",
        "        print(\"\\n📂 Google Drive checkpoint specified - mounting drive...\")\n",
        "        if mount_google_drive():\n",
        "            configured_checkpoint_path = setup_alignedreid_checkpoint()\n",
        "        else:\n",
        "            print(\"❌ Could not mount Google Drive\")\n",
        "    else:\n",
        "        configured_checkpoint_path = setup_alignedreid_checkpoint()\n",
        "else:\n",
        "    print(\"\\n⚠️ No checkpoint source configured.\")\n",
        "    print(\"📝 Please set one of the options above and re-run this cell.\")\n",
        "    print(\"💡 The system will fallback to ResNet50 ImageNet weights if no checkpoint is provided.\")\n",
        "\n",
        "# Store the path for the ReID initialization\n",
        "CONFIGURED_CHECKPOINT_PATH = configured_checkpoint_path\n",
        "\n",
        "print(f\"\\n🎯 Final checkpoint path: {CONFIGURED_CHECKPOINT_PATH}\")\n",
        "\n",
        "if CONFIGURED_CHECKPOINT_PATH:\n",
        "    print(\"✅ Ready to initialize AlignedReID with your pretrained weights!\")\n",
        "else:\n",
        "    print(\"⚠️ No checkpoint configured - will use ResNet50 fallback\")\n",
        "\n",
        "print(\"\\n📝 Next: Run the AlignedReID initialization cell below\")"
      ]
    },
